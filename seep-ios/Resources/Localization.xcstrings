    "settings.footer" : {
      "comment" : "설정 탭",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seep has no server — everything stays on this device. Deleting the app deletes your wishes too."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seepはサーバーを使わず、このデバイスにだけ保存されます。アプリを削除すると、書いたウィッシュも一緒に消えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "싶은 서버 없이 이 기기에만 저장돼요. 앱을 지우면 적어 둔 싶도 함께 지워져요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seep 不使用服务器，数据只保存在这台设备上。删除 App 后，写下的心愿也会一并删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seep 不使用伺服器，資料只保存在這台裝置上。刪除 App 後，寫下的心願也會一併刪除。"
          }
        }
      }
    },
