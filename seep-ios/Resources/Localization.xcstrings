        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n\n---\nApp 版本：%@\niOS 版本：%@\n设备：%@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
