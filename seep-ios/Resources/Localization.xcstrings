    "app_lock.sheet.disable_description" : {
      "comment" : "앱 잠금",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With the lock off, Seep won't ask when you open it.\nWe'll check it's you one more time first."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロックをオフにすると、アプリを開くときに確認しなくなります。\nオフにする前にもう一度確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠금을 끄면 앱을 열 때 더 묻지 않아요.\n끄기 전에 한 번 더 확인할게요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭后，打开 App 时将不再验证。\n关闭前会再确认一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉後，開啟 App 時將不再驗證。\n關閉前會再確認一次。"
          }
        }
      }
    },
    "app_lock.sheet.disable_title" : {
