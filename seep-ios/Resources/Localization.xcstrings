    "control_guide.control.description" : {
      "comment" : "설정 · 제어 센터 · 단축어 안내",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the \"Write a wish\" control to jump straight to writing without finding the app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Seepに書く」コントロールを置くと、アプリを探さずにすぐ作成画面を開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"싶 적기\" 컨트롤을 두면 앱을 찾지 않고 바로 작성 화면을 열어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加“写下心愿”控制后，无需寻找 App 就能直接打开填写页面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入「寫下心願」控制項後，不用找 App 就能直接開啟填寫頁面。"
          }
        }
      }
    },
    "control_guide.control.step1" : {
      "comment" : "설정 · 제어 센터 · 단축어 안내",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Control Center and tap ＋ in the top left."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントロールセンターを開き、左上の＋をタップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제어 센터를 열고 왼쪽 위 ＋를 눌러요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开控制中心，轻点左上角的＋。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打開控制中心，點一下左上角的＋。"
          }
        }
      }
    },
    "control_guide.control.step2" : {
      "comment" : "설정 · 제어 센터 · 단축어 안내",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Add a Control, find \"Write a wish\" and place it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「コントロールを追加」で「Seepに書く」を探して配置します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제어 항목 추가에서 \"싶 적기\"를 찾아 놓아요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“添加控制”中找到“写下心愿”并放好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「加入控制項」中找到「寫下心願」並放好。"
          }
        }
      }
    },
    "control_guide.control.step3" : {
      "comment" : "설정 · 제어 센터 · 단축어 안내",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold the control to pick a category."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントロールを長押しするとカテゴリを選べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컨트롤을 길게 눌러 카테고리를 고를 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按控制即可选择分类。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長按控制項即可選擇類別。"
          }
        }
      }
    },
