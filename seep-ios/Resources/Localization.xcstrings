    "app_lock.sheet.enable_description_format" : {
      "comment" : "앱 잠금. %@ = Face ID 또는 Touch ID",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seep will ask for %@ or your passcode when you open it.\nHome Screen widgets still show while locked."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを開くときに%@かデバイスのパスコードで確認します。\nホーム画面のウィジェットはロックに関係なく表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 열 때 %@나 기기 암호를 물어봐요.\n홈 화면 위젯은 잠금과 상관없이 보여요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开 App 时会要求%@或设备密码。\n主屏幕小组件不受锁定影响，照常显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟 App 時會要求%@或裝置密碼。\n主畫面小工具不受鎖定影響，照常顯示。"
          }
        }
      }
    },
