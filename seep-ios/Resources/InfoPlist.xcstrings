    "NSFaceIDUsageDescription" : {
      "comment" : "권한 팝업 · Face ID 사용",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you lock Seep, Face ID is used to confirm it's you when you open the app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seepをロックすると、アプリを開くときにFace IDで確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "싶을 잠가두면 앱을 열 때 Face ID로 확인해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "锁定 Seep 后，打开 App 时将使用 Face ID 进行验证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鎖定 Seep 後，開啟 App 時將使用 Face ID 進行驗證。"
          }
        }
      }
    },
