    "NSCalendarsUsageDescription" : {
      "comment" : "권한 팝업 · 캘린더 접근(전체)",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seep needs calendar access to add your wish dates as calendar events."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィッシュの日付をカレンダーに予定として追加するため、カレンダーへのアクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위시 날짜를 캘린더에 일정으로 추가하기 위해 캘린더 접근이 필요해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要访问你的日历，以便将心愿日期添加为日程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要取用你的行事曆，以便將心願日期加入為行程。"
          }
        }
      }
    },
